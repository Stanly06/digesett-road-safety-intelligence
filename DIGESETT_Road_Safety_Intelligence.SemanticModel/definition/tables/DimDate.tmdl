		formatString: 0
		lineageTag: f86b7587-9945-4fef-a6d1-82359244b769
		summarizeBy: none
		sourceColumn: YearMonthSort

	column MonthStartDate
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: d748a060-29e0-4b4b-a6ee-67e82eb197ee
		summarizeBy: none
		sourceColumn: MonthStartDate

		annotation UnderlyingDateTimeDataType = Date

	column MonthIndex
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: afdd9ec0-155b-4afe-9c04-2c149363902d
		summarizeBy: none
		sourceColumn: MonthIndex

	column HasViolationData
		dataType: boolean
		lineageTag: 2b16e6bd-a404-4f97-856c-d4e24cc7ac66
		summarizeBy: none
		sourceColumn: HasViolationData

	column HasFatalityData
		dataType: boolean
		lineageTag: 3a1ab2b0-110c-4a8c-a639-cb17a75b592e
		summarizeBy: none
		sourceColumn: HasFatalityData

