table DimDate
	lineageTag: 961fd21a-9721-4157-9d62-c1dfd458bf24
	dataCategory: Time

	column Date
		dataType: dateTime
		isHidden
		isKey
		formatString: Short Date
		lineageTag: 3d9f6b54-1329-4747-8fd2-a2d765fce40e
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: abba9b47-6a1f-41cc-a71d-eed3e236ad60
		summarizeBy: none
		sourceColumn: Year

	column MonthNumber
