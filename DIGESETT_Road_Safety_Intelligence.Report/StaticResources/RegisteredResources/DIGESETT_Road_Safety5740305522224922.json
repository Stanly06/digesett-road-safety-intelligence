{
  "name": "DIGESETT Road Safety",
  "dataColors": [
    "#FFC72C",
    "#2A9D8F",
    "#F28C28",
    "#E5383B",
    "#8FA3B8",
    "#E9D8A6",
    "#6FCF97",
    "#C9A227",
    "#B56576",
    "#6C757D"
  ],
  "background": "#272B31",
  "foreground": "#F4F5F6",
  "tableAccent": "#FFC72C",
  "good": "#2A9D8F",
  "neutral": "#FFC72C",
  "bad": "#E5383B",
  "maximum": "#FFC72C",
  "center": "#8A6E1F",
  "minimum": "#33383F",
  "foregroundNeutralSecondary": "#A7AEB6",
  "foregroundNeutralTertiary": "#7C848D",
  "backgroundLight": "#30353C",
  "backgroundNeutral": "#3A4048",
  "hyperlink": "#FFC72C",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFC72C"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#F4F5F6"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#F4F5F6"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A7AEB6"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#272B31"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#3A4048"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F4F5F6"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#1B1E22"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#121417"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F4F5F6"
              }
            },
            "background": {
              "solid": {
                "color": "#272B31"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#A7AEB6"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#A7AEB6"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#3A4048"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#A7AEB6"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#3A4048"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFC72C"
              }
            },
            "backColor": {
              "solid": {
                "color": "#272B31"
              }
            }
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#F4F5F6"
              }
            },
            "backColor": {
              "solid": {
                "color": "#272B31"
              }
            },
            "altBackColor": {
              "solid": {
                "color": "#2C3138"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#3A4048"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFC72C"
              }
            },
            "backColor": {
              "solid": {
                "color": "#272B31"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F4F5F6"
              }
            },
            "backColor": {
              "solid": {
                "color": "#272B31"
              }
            }
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#F4F5F6"
              }
            },
            "backColor": {
              "solid": {
                "color": "#272B31"
              }
            },
            "altBackColor": {
              "solid": {
                "color": "#2C3138"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "labelDisplayUnits": 1
          }
        ]
      }
    }
  }
}